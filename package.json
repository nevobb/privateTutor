{
  "name": "myapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:firebase:auth": "FIREBASE_AUTH_EMULATOR_TEST=1 vitest run tests/firebase/auth.emulator.test.ts tests/firebase/tutorRouteAuth.emulator.test.ts",
    "test:firebase:auth:emulators": "firebase emulators:exec --only auth --project demo-private-tutor \"npm run test:firebase:auth\"",
    "test:firebase:workspace": "FIREBASE_WORKSPACE_EMULATOR_TEST=1 vitest run --fileParallelism=false tests/firebase/workspacePersistence.emulator.test.ts tests/firebase/workspaceRoutePersistence.emulator.test.ts tests/server/workspaces/workspaceRepository.test.ts tests/server/workspaces/messageRepository.test.ts tests/server/workspaces/decisionLogRepository.test.ts",
    "test:firebase:workspace:emulators": "firebase emulators:exec --only firestore --project demo-private-tutor \"npm run test:firebase:workspace\"",
    "test:firebase:rules": "FIREBASE_RULES_TEST=1 vitest run tests/firebase",
    "test:firebase:rules:emulators": "FIREBASE_RULES_TEST=1 firebase emulators:exec --only auth,firestore,storage --project demo-private-tutor \"vitest run tests/firebase\""
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
