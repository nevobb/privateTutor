rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // First-pass emulator rules only. These rules are not production-ready.
    // MVP file-type direction: digital PDF and DOCX files only.
    // TODO: add explicit MIME type and file size limits before runtime upload.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
